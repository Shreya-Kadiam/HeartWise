  "winner_analysis": {
    "best_model": "Logistic Regression",
    "headline": "Why Logistic Regression Outperforms Random Forest & KNN on This Dataset",
    "points": [
      {
        "title": "Smooth Linear Clinical Risk Relationship",
        "detail": "In this 4,000-row clinical dataset, cardiovascular risk rises smoothly and additively with standardized biomarkers (max heart rate, age, ST depression, chest pain type, exercise-induced angina, smoking, HbA1c, HDL). Logistic Regression learns this smooth log-odds boundary directly, whereas Random Forest approximates diagonal boundaries using axis-aligned step splits."
      },
      {
        "title": "Higher Sensitivity (Recall) & ROC-AUC on Test Data",
        "detail": "On the 600-patient held-out test set, Logistic Regression achieves 96.1% ROC-AUC, 89.7% accuracy, and 89.0% recall on Heart Disease cases \u2014 outperforming Random Forest (95.5% ROC-AUC, 86.8% recall) and KNN (92.5% ROC-AUC, 56.0% recall)."
      },
      {
        "title": "Why KNN Trails Behind",
        "detail": "After One-Hot Encoding categorical features, the feature space has 25+ dimensions. Distance-based KNN suffers from the curse of dimensionality, causing lower recall (56.0%) compared to parametric and ensemble methods."
      },
      {
        "title": "Well-Calibrated Probabilities & Interpretability",
        "detail": "Logistic Regression produces naturally calibrated risk percentages (0%\u2013100%) and clear positive/negative feature weights (coefficients), which is ideal for medical screening."
      }
    ]
  }
